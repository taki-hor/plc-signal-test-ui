PLC_API_BASE_URL=http://192.168.x.x:8000
PLC_API_KEY=
PLC_REQUEST_TIMEOUT=5
PLC_UI_POLL_INTERVAL_MS=1000
PLC_STALE_AFTER_MS=3000
# Set only after confirming the supplier clock timezone, e.g. Asia/Hong_Kong.
PLC_TIMESTAMP_TIMEZONE=
# Temporary signed seconds added to supplier timestamps. Reset to 0 after clock sync.
PLC_TIMESTAMP_OFFSET_SECONDS=0
PLC_MOCK_MODE=true
